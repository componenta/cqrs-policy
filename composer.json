{
    "name": "componenta/cqrs-policy",
    "description": "Policy middleware integration for Componenta CQRS",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "componenta/config": "^3.0.0",
        "componenta/cqrs": "^4.0.0",
        "componenta/identity": "^1.0",
        "componenta/policy": "^3.0.0"
    },
    "require-dev": {
        "componenta/cqrs-transport": "^5.0.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "componenta/cqrs-transport": "4.0+ adds composite actor-aware JSON command serialization for asynchronous policy commands."
    },
    "autoload": {
        "psr-4": {
            "Componenta\\CQRS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\CQRS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\CQRS\\Policy\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.0.x-dev"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src --level=max"
    }
}
